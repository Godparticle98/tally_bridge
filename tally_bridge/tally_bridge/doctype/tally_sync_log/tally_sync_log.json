      "label": "Connection",
      "in_list_view": 1
    },
    {
      "fieldname": "source_doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "label": "Source DocType"
    },
    {
      "fieldname": "source_name",
      "fieldtype": "Data",
      "label": "Source Name"
    },
    {
      "fieldname": "event",
      "fieldtype": "Data",
      "label": "Event"
    },
    {
      "fieldname": "http_status",
      "fieldtype": "Int",
      "label": "HTTP Status"
    },
    {
      "fieldname": "latency_ms",
      "fieldtype": "Float",
      "label": "Latency (ms)"
    },
    {
